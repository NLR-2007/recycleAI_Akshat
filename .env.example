# ---- Primary AI provider: Groq (OpenAI-compatible) ----
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
# Vision-capable Groq model (must support image_url content parts)
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ---- Fallback AI provider: NVIDIA NIM (OpenAI-compatible) ----
# Get a key at https://build.nvidia.com
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key
NVIDIA_NIM_MODEL=meta/llama-4-maverick-17b-128e-instruct
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Comma-separated provider order. Values: groq, nvidia
AI_PROVIDER_ORDER=groq,nvidia
